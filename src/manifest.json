{
  "manifest_version": 3,
  "name": "Precog",
  "version": "0.2.0.17",
  "description": "An open source Chrome extension that extracts page context, assembles a prompt, and runs it in Claude.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "optional_permissions": ["tabs", "nativeMessaging"],
  "optional_host_permissions": ["https://app.asana.com/*", "https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open Precog command palette"
    },
    "copy-thread-link": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Command+MacCtrl+C"
      },
      "description": "Copy Gmail thread link for Claude, or Asana task description"
    },
    "copy-window-urls": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Command+MacCtrl+T"
      },
      "description": "Copy URLs of all tabs in this window"
    },
    "open-links-tabs-new-window": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Command+MacCtrl+W"
      },
      "description": "Open all links in the selection as tabs in a new window"
    },
    "create-asana-task": {
      "description": "Create an Asana task from this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://claude.ai/*"],
      "js": [
        "content/shared.js",
        "content/gmail.js",
        "content/asana.js",
        "content/slack.js",
        "content/generic.js",
        "content/loader.js"
      ],
      "css": ["content/precog.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/claude.js"]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
